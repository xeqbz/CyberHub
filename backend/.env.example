# =========================
# App
# =========================
APP_NAME=CyberHub Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# =========================
# Security
# =========================
SECRET_KEY=my_long_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# =========================
# PostgreSQL
# =========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyberhub
POSTGRES_USER=cyberhub
POSTGRES_PASSWORD=cyberhub

# Full database URL (optional if assembled in config)
DATABASE_URL=postgresql+psycopg://cyberhub:cyberhub@postgres:5432/cyberhub

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# =========================
# Celery
# =========================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =========================
# CORS
# =========================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =========================
# WebSocket
# =========================
WS_HEARTBEAT_INTERVAL=30

# =========================
# Logging
# =========================
LOG_LEVEL=INFO